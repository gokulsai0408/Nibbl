# Forkcast runtime config (bundled into the app at build time; see README).
# USE_MOCK_AI=true runs the offline demo AI.

USE_MOCK_AI=false
AI_PROVIDER=anthropic

# Paste your Claude API key after the = (starts with sk-ant-).
# NOTE: a key in this file is baked into the APK. Fine on your own phone,
# but use proxy/worker.js before sharing the app with anyone.
AI_API_KEY=

# Optional. Defaults: base URL https://api.anthropic.com, model claude-opus-5-5.
# For a much cheaper/faster option, set AI_MODEL=claude-haiku-5-5
AI_BASE_URL=
AI_MODEL=claude-opus-5-5
AI_VISION_MODEL=claude-opus-5-5

# Friends & posts (optional). Create a free project at https://supabase.com,
# run supabase/schema.sql in its SQL editor, enable anonymous sign-ins, then
# paste Project URL and the publishable (anon) key from Settings -> API.
# Leave empty to use the offline demo.
SUPABASE_URL=
SUPABASE_KEY=
